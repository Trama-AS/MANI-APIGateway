      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{job=\"mani_core_qa\",route!~\".*(health|metrics).*\",status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=\"mani_core_qa\",route!~\".*(health|metrics).*\"}[5m]))",
