    {
      "id": 8,
      "type": "timeseries",
      "title": "PROD Tasa 5xx (%)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{ambiente=\"prod\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{ambiente=\"prod\"}[5m])), 0.001)",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PROD Latencia P95 Core (s)",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{ambiente=\"prod\"}[5m])))",
          "legendFormat": "P95 (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Exporters Infraestructura QA (SCRUM-1671)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "QA VM CPU (%)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{ambiente=\"qa\",mode=\"idle\"}[5m])))",
          "legendFormat": "CPU VM %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "QA VM Memoria Usada (%)",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{ambiente=\"qa\"} / node_memory_MemTotal_bytes{ambiente=\"qa\"}))",
          "legendFormat": "RAM VM %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "QA Postgres Conexiones Activas",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{ambiente=\"qa\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "QA Contenedores CPU (%) (cAdvisor)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{ambiente=\"qa\",name=~\"mani-.*\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "QA Contenedores RAM (MB) (cAdvisor)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{ambiente=\"qa\",name=~\"mani-.*\"} / 1048576",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "NGINX Gateway & Log Exporter QA (SCRUM-1671)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "NGINX Conexiones Activas / Aceptadas",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "nginx_connections_active{ambiente=\"qa\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "rate(nginx_connections_accepted{ambiente=\"qa\"}[5m])",
          "legendFormat": "accepted/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Gateway Requests por Status (req/s)",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(nginx_http_response_count_total{ambiente=\"qa\"}[5m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Gateway Rechazos 401/403/429/5xx (ult. 15m)",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(nginx_http_response_count_total{ambiente=\"qa\",status=~\"401|403|429|5..\"}[15m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Logs Centralizados Loki QA (SCRUM-1676 / ADR-0038)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Stream Logs Servicios MANI QA",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{ambiente=\"qa\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
