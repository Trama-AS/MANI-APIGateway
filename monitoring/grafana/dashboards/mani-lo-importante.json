    },
    {
      "type": "row",
      "title": "2. Tráfico y errores por servicio (medido en el Gateway)",
      "collapsed": false,
      "id": 5,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (ambiente, route) (rate(nginx_http_response_count_total{ambiente=~\"$ambiente\",route=~\"core|core-auth|rules|dispatch\"}[5m]))",
          "legendFormat": "{{ambiente}} {{route}}",
          "refId": "A"
        }
      ],
      "description": "Todas las peticiones que pasan por el Gateway, agrupadas por servicio de destino."
    },
    {
      "type": "timeseries",
      "title": "% de 5xx",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (ambiente, route) (rate(nginx_http_response_count_total{ambiente=~\"$ambiente\",route=~\"core|core-auth|rules|dispatch\",status=~\"5..\"}[5m])) / clamp_min(sum by (ambiente, route) (rate(nginx_http_response_count_total{ambiente=~\"$ambiente\",route=~\"core|core-auth|rules|dispatch\"}[5m])), 0.001)",
          "legendFormat": "{{ambiente}} {{route}}",
          "refId": "A"
        }
      ],
      "description": "Errores del servidor. Umbral de la alerta High5xxRateGateway: 1 %."
    },
    {
      "type": "timeseries",
      "title": "Rechazos 401 / 403 / 429",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
