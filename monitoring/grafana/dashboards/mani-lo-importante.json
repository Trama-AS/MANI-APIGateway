      "targets": [
        {
          "expr": "sum by (ambiente, route, status) (rate(nginx_http_response_count_total{ambiente=~\"$ambiente\",route=~\"core|core-auth|rules|dispatch\",status=~\"401|403|429\"}[5m]))",
