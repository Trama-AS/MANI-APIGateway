    },
    {
      "type": "stat",
      "title": "Endpoints ahora",
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAIDO",
                  "color": "red"
                },
                "1": {
                  "text": "ARRIBA",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "probe_success{ambiente=~\"$ambiente\"}",
          "legendFormat": "{{ambiente}} {{instance}}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Sonda HTTP cada 30 s a /health de Gateway, Core, Dispatch, Rules, Flutter (:8080) y Landing (:3001). Alerta ServiceDown a los 2 min."
    },
    {
      "type": "stat",
      "title": "Disponibilidad 24 h",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "avg by (ambiente) (avg_over_time(probe_success{ambiente=~\"$ambiente\"}[24h]))",
          "legendFormat": "{{ambiente}}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Promedio de las sondas en 24 h. Objetivo >= 99,9 %."
    },
    {
      "type": "stat",
