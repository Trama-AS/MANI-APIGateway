# Base de datos local con Docker (perfil "db" de docker-compose.yml).
# Copiar a .env (ignorado por git). Valores solo para DEV local, nunca de QA ni PROD.
POSTGRES_DB=mani_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
ADMINER_PORT=8088

# Cliente Flutter Web (perfil "web")
WEB_PORT=8080

# Core y Dispatch contra el proyecto Supabase de DEV (perfil por defecto y "full").
# La app inicia sesión en ese proyecto: Core necesita su URL para validar los tokens ES256 (JWKS) y su base
# para leer y escribir. Sin SUPABASE_URL todas las peticiones con sesión responden 401; sin DATABASE_URL,
# las de solicitudes, cotización, pagos, calificación, etc. responden 503. Pedir los valores al equipo;
# nunca subir este archivo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# postgresql://mani_core_svc.<ref>:<clave>@<pooler>:5432/postgres
DATABASE_URL=
# postgresql://mani_dispatch_svc.<ref>:<clave>@<pooler>:5432/postgres
DISPATCH_DATABASE_URL=
