# Plantilla de configuracion para respaldos automaticos de MANI (SCRUM-1666 / T-29)
# Copiar en la VM de Backups (10.43.98.197) como /etc/mani-backups/.env.backups (chmod 600).
# NUNCA subir el archivo real con credenciales al repositorio Git.

# Ambientes a respaldar (separados por espacio)
BACKUP_ENVS="qa prod"

# Cadenas administrativas (Session Pooler puerto 5432, solo en la VM)
QA_DATABASE_URL="postgresql://postgres.<ref_qa>:<password>@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"
PROD_DATABASE_URL="postgresql://postgres.<ref_prod>:<password>@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Esquemas a respaldar y validar
BACKUP_SCHEMAS="public app"

# Almacenamiento local y cifrado en reposo (OpenSSL AES-256-CBC + PBKDF2)
BACKUP_ROOT="/opt/database-backups/mani"
BACKUP_ENCRYPTION_KEY_FILE="/etc/mani-backups/backup.passphrase"
RETENTION_DAILY=14
RETENTION_WEEKLY=4

# Copia externa cifrada off-host (VM Calidad 10.43.98.196)
OFFSITE_RSYNC_TARGET="estudiante@10.43.98.196:/opt/database-backups-replica/mani"
OFFSITE_SSH_KEY="/home/estudiante/.ssh/id_ed25519_backups_offsite"

# Instancia PostgreSQL 17 aislada para simulacros de restauracion (no compartida)
DRILL_PG_HOST="127.0.0.1"
DRILL_PG_PORT="5433"
DRILL_PG_USER="postgres"
RTO_TARGET_SECONDS=1800

# Directorio del textfile collector de Prometheus node_exporter
TEXTFILE_DIR="/var/lib/node_exporter/textfile_collector"
