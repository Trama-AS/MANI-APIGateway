# Plantilla de variables para /opt/mani/.env.qa (sin secretos)
ENVIRONMENT=qa
TAG=staging
DOTNET_ENV=Staging
GATEWAY_PORT=80
FLUTTER_PORT=8080
LANDING_PORT=3001
SUPABASE_URL=https://REEMPLAZAR_REF.supabase.co
SUPABASE_ANON_KEY=REEMPLAZAR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REEMPLAZAR_JWT_SECRET
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
DISPATCH_DB_CONNECTION=Host=host;Port=5432;Database=postgres;Username=usuario;Password=clave
